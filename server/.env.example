# Server (copy to .env and adjust). Never commit real secrets.
PORT=5000
# Bind address (cloud hosts need 0.0.0.0; local default is fine)
HOST=0.0.0.0
NODE_ENV=development

# MongoDB connection string (local mongod or Atlas mongodb+srv://...)
MONGODB_URI=mongodb://127.0.0.1:27017/queueit

# JWT signing secret (use a long random string locally / in production)
JWT_SECRET=change-me-in-local-env-only
# Optional token lifetime (jsonwebtoken format)
JWT_EXPIRES_IN=7d

# Optional HMAC secret for signed arrival-pass QRs. Falls back to JWT_SECRET.
# ARRIVAL_PASS_SECRET=
# Set to 1/true to accept legacy unsigned QIT: passes and typed token numbers.
# Leave unset so only signed arrival passes verify (default).
# ALLOW_UNSIGNED_ARRIVAL=

# CORS origin for the React client.
# Local: http://localhost:5173
# Production: https://your-frontend.vercel.app  (comma-separated list ok)
CLIENT_ORIGIN=http://localhost:5173

# When "true", upsert demo accounts + venue/queues on process start (idempotent).
# Use on first production deploy; leave unset or false for normal local dev.
# SEED_ON_BOOT=false
# When "true", re-seed also restores default service windows and status=open.
# Leave unset so admin-edited windows and pause/closed state are preserved.
# SEED_RESET_CATALOG=false

# Demo seed accounts — set your own passwords; never commit real .env values.
# After setting these, run: npm run seed -w server
# In production: set the same keys on the host dashboard (not in git).
SEED_ADMIN_EMAIL=admin@queueit.local
SEED_ADMIN_PASSWORD=replace-with-local-admin-password
SEED_ADMIN_NAME=Demo Admin
SEED_USER_EMAIL=user@queueit.local
SEED_USER_PASSWORD=replace-with-local-user-password
SEED_USER_NAME=Demo User

# Long-running host only: how often to close expired sessions (ms, default 15000).
# SESSION_CLOSE_INTERVAL_MS=15000
