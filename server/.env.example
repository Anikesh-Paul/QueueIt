# Server (copy to .env and adjust). Never commit real secrets.
PORT=5000
NODE_ENV=development
# MongoDB connection string (used in later tickets; optional for scaffold)
# MONGODB_URI=mongodb://127.0.0.1:27017/queueit
# JWT secret (used in later tickets; do not put production values here)
# JWT_SECRET=change-me-in-local-env-only
# CORS origin for the React client in local dev
CLIENT_ORIGIN=http://localhost:5173
