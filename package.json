{
  "name": "queueit",
  "version": "0.1.0",
  "private": true,
  "description": "QueueIt — virtual queue management (MERN monorepo)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "test": "npm run test -w server && npm run test -w client",
    "test:server": "npm run test -w server",
    "seed": "npm run seed -w server",
    "seed:e2e": "npm run seed:e2e -w server",
    "test:e2e": "npm run seed:e2e && playwright test e2e/smoke",
    "start:server": "npm run start -w server",
    "build:client": "npm run build -w client",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "vercel": "^58.7.1"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "engine.io": "6.6.11",
    "qs": "6.17.1",
    "proxy-addr": "2.0.8",
    "ip-address": "10.7.6"
  }
}
